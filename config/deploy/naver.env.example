# Docker images
DOCKER_USERNAME=CHANGE_ME
FRONTEND_IMAGE_TAG=latest

# Local PostgreSQL on Naver Cloud
POSTGRES_DB=bubli
POSTGRES_USER=bubli
POSTGRES_PASSWORD=CHANGE_ME

# Local persistent storage on Naver Cloud
STORAGE_TYPE=local

# Keep Bedrock chat while running embeddings locally with Ollama.
# Set AI_CHAT_PROVIDER=none and AGENT_EXECUTION_MODE=noop if Bedrock is not used.
AI_CHAT_PROVIDER=bedrock-converse
AI_EMBEDDING_PROVIDER=ollama
AI_EMBEDDING_DIMENSIONS=1024
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
BEDROCK_CHAT_MODEL_ID=apac.anthropic.claude-3-haiku-20240307-v1:0

# Ollama is private to the Compose network; do not publish port 11434.
OLLAMA_IMAGE=ollama/ollama:0.11.10
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_BATCH=32
OLLAMA_NUM_GPU=0
OLLAMA_NUM_THREAD=2

# Application secrets
JWT_SECRET=CHANGE_ME_AT_LEAST_32_BYTES
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://bubli.n-e.kr/login/oauth2/code/google
GOOGLE_CALENDAR_CLIENT_ID=CHANGE_ME
GOOGLE_CALENDAR_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALENDAR_REDIRECT_URI=https://bubli.n-e.kr/api/calendar/google/callback
LIVEKIT_API_KEY=CHANGE_ME
LIVEKIT_API_SECRET=CHANGE_ME
LIVEKIT_SERVER_URL=CHANGE_ME
CORS_ALLOWED_ORIGIN_PATTERNS=https://bubli.n-e.kr,tauri://localhost,http://tauri.localhost,http://localhost:3000,http://localhost:5173,http://localhost:1420
AGENT_EXECUTION_MODE=llm
AGENT_DISPATCH_ADAPTER=redis

# First deployment: use nginx.http-only.conf. After issuing the certificate,
# change this value to ./infra/nginx/nginx.conf and recreate nginx.
NGINX_CONFIG_PATH=./infra/nginx/nginx.http-only.conf
