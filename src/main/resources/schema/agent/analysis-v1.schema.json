{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bubli.local/schema/agent/analysis-v1.schema.json",
  "title": "Bubli Agent Analysis Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resourceId",
    "model",
    "analysis",
    "suggestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "analysis.v1"
    },
    "resourceId": {
      "type": "string",
      "format": "uuid"
    },
    "model": {
      "$ref": "#/$defs/model"
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suggestion"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "promptVersion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "keywords",
        "risks",
        "checklist"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checklist": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checklistItem"
          }
        }
      }
    },
    "checklistItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "severity"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "suggestion": {
      "oneOf": [
        {
          "$ref": "#/$defs/taskSuggestion"
        },
        {
          "$ref": "#/$defs/requirementSuggestion"
        },
        {
          "$ref": "#/$defs/contractFieldSuggestion"
        },
        {
          "$ref": "#/$defs/wbsSuggestion"
        },
        {
          "$ref": "#/$defs/questionSuggestion"
        },
        {
          "$ref": "#/$defs/reviewItemSuggestion"
        },
        {
          "$ref": "#/$defs/documentDraftSuggestion"
        },
        {
          "$ref": "#/$defs/dailySummarySuggestion"
        }
      ]
    },
    "suggestionProperties": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "TASK",
            "REQUIREMENT",
            "WBS",
            "QUESTION",
            "CONTRACT_FIELD",
            "REVIEW_ITEM",
            "DOCUMENT_DRAFT",
            "DAILY_SUMMARY"
          ]
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "sourceText": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fieldKey": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "assigneeUserId": {
          "type": "string"
        },
        "wbsItemId": {
          "type": "string"
        },
        "parentId": {
          "type": "string"
        },
        "orderNo": {
          "type": "integer"
        },
        "status": {
          "type": "string"
        },
        "startsAt": {
          "type": "string"
        },
        "dueAt": {
          "type": "string"
        },
        "endsAt": {
          "type": "string"
        },
        "allDay": {
          "type": "boolean"
        },
        "scheduleTitle": {
          "type": "string"
        },
        "documentType": {
          "type": "string"
        },
        "contentMarkdown": {
          "type": "string"
        }
      }
    },
    "taskSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "sourceText"
          ],
          "properties": {
            "type": {
              "const": "TASK"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "sourceText": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "assigneeUserId": {
              "type": "string"
            },
            "wbsItemId": {
              "type": "string"
            },
            "startsAt": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "endsAt": {
              "type": "string"
            },
            "allDay": {
              "type": "boolean"
            },
            "scheduleTitle": {
              "type": "string"
            },
            "documentType": {
              "type": "string"
            },
            "contentMarkdown": {
              "type": "string"
            },
            "fieldKey": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "requirementSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "description"
          ],
          "properties": {
            "type": {
              "const": "REQUIREMENT"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sourceText": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "assigneeUserId": {
              "type": "string"
            },
            "wbsItemId": {
              "type": "string"
            },
            "startsAt": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "endsAt": {
              "type": "string"
            },
            "allDay": {
              "type": "boolean"
            },
            "scheduleTitle": {
              "type": "string"
            },
            "documentType": {
              "type": "string"
            },
            "contentMarkdown": {
              "type": "string"
            },
            "fieldKey": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    },
    "contractFieldSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "fieldKey",
            "value"
          ],
          "properties": {
            "type": {
              "const": "CONTRACT_FIELD"
            },
            "title": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "sourceText": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "assigneeUserId": {
              "type": "string"
            },
            "wbsItemId": {
              "type": "string"
            },
            "startsAt": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "endsAt": {
              "type": "string"
            },
            "allDay": {
              "type": "boolean"
            },
            "scheduleTitle": {
              "type": "string"
            },
            "documentType": {
              "type": "string"
            },
            "contentMarkdown": {
              "type": "string"
            },
            "fieldKey": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "wbsSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "title"
          ],
          "properties": {
            "type": {
              "const": "WBS"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "sourceText": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "parentId": {
              "type": "string"
            },
            "orderNo": {
              "type": "integer"
            },
            "status": {
              "type": "string"
            },
            "startsAt": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "endsAt": {
              "type": "string"
            },
            "allDay": {
              "type": "boolean"
            },
            "scheduleTitle": {
              "type": "string"
            }
          }
        }
      ]
    },
    "questionSuggestion": {
      "$ref": "#/$defs/genericSuggestion"
    },
    "reviewItemSuggestion": {
      "$ref": "#/$defs/genericSuggestion"
    },
    "dailySummarySuggestion": {
      "$ref": "#/$defs/genericSuggestion"
    },
    "documentDraftSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "title",
            "description",
            "contentMarkdown"
          ],
          "properties": {
            "type": {
              "const": "DOCUMENT_DRAFT"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "sourceText": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "documentType": {
              "type": "string"
            },
            "contentMarkdown": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "genericSuggestion": {
      "allOf": [
        {
          "$ref": "#/$defs/suggestionProperties"
        },
        {
          "additionalProperties": false,
          "required": [
            "type",
            "title"
          ],
          "properties": {
            "type": {
              "enum": [
                "QUESTION",
                "REVIEW_ITEM",
                "DAILY_SUMMARY"
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "sourceText": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "startsAt": {
              "type": "string"
            },
            "dueAt": {
              "type": "string"
            },
            "endsAt": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
