{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Search requests by strategy and outcome",
      "id": 1,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (strategy, outcome) (rate(bubli_ai_search_requests_total[$__rate_interval]))",
          "legendFormat": "{{strategy}} / {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Search latency p50 / p95 / p99",
      "id": 2,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, strategy) (rate(bubli_ai_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{strategy}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(bubli_ai_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{strategy}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(bubli_ai_search_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{strategy}}",
          "refId": "C"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Empty result rate",
      "id": 3,
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(bubli_ai_search_requests_total{outcome=\"empty\"}[$__rate_interval])) / clamp_min(sum(rate(bubli_ai_search_requests_total[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate",
      "id": 4,
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 8},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "expr": "sum(rate(bubli_ai_search_requests_total{outcome=\"error\"}[$__rate_interval])) / clamp_min(sum(rate(bubli_ai_search_requests_total[$__rate_interval])), 1e-9)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average result count",
      "id": 5,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "sum by (strategy) (rate(bubli_ai_search_results_sum[$__rate_interval])) / clamp_min(sum by (strategy) (rate(bubli_ai_search_results_count[$__rate_interval])), 1e-9)",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Average maximum score",
      "id": 6,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 8},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "expr": "sum by (strategy) (rate(bubli_ai_search_max_score_sum[$__rate_interval])) / clamp_min(sum by (strategy) (rate(bubli_ai_search_max_score_count[$__rate_interval])), 1e-9)",
          "legendFormat": "{{strategy}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Grounding threshold acceptance rate",
      "id": 7,
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 14},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {
          "expr": "sum by (strategy, scope) (rate(bubli_ai_search_accepted_total[$__rate_interval])) / clamp_min(sum by (strategy, scope) (rate(bubli_ai_search_candidates_total[$__rate_interval])), 1e-9)",
          "legendFormat": "{{strategy}} / {{scope}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fallback outcomes",
      "id": 8,
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "expr": "sum by (strategy, outcome) (rate(bubli_ai_search_fallback_total[$__rate_interval]))",
          "legendFormat": "{{strategy}} / {{outcome}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bubli", "ai", "search"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Bubli AI Search Observability",
  "uid": "bubli-ai-search",
  "version": 1
}
